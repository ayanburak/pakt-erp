# Bu dosya .env için şablondur. .env olarak kopyalanır ve büyük harfle
# yazılan yerler doldurulur. .env repoya gönderilmez.

# Uygulamanın bağlandığı rol. Sadece satır okuyup yazabilir.
DATABASE_URL=postgresql+psycopg://pakt_erp_app:SIFRE@127.0.0.1:5432/pakt_erp

# Migration'ları çalıştıran kullanıcı. Adreste sunucu kısmı boş bırakılırsa
# bağlantı yerel soketten kurulur ve PostgreSQL şifre yerine sistem
# kullanıcısına bakar.
MIGRATION_DATABASE_URL=postgresql+psycopg://KULLANICI@/pakt_erp

# Migration'dan önce geçilecek, tabloların sahibi olan rol. Boş bırakılırsa
# rol değiştirilmez.
MIGRATION_ROLE=pakt_erp_owner

# Testler bu adreslerin veritabanı adına _test ekleyerek çalışır, test için
# ayrı bir ayar yazılmaz.
